# StartupStory Environment Variables

# Optional: Resend API Key for dispatching live launch notification emails.
# If unset, signups are securely recorded in the local database (data/subscribers.json)
# and email dispatch will wait until an API key is provided.
# RESEND_API_KEY=re_123456789...

# Sender address used when sending notification emails
EMAIL_FROM="StartupStory <notifications@startupstory.tech>"

# Optional: Custom salt for hashing IP addresses in rate-limiting
RATE_LIMIT_SALT="startupstory-custom-salt"
